// ==============================================================================
// NurseFlow Enterprise HIS 2026 — Comprehensive Prisma ORM Schema (Gate 1D.4)
// Standar: Permenkes No. 24/2022, Permenkes No. 91/2015, WHO Blood Safety, JCI IPSG
// Features: Tenant Isolation, Bed Hierarchy, Appointments, Pharmacy FEFO, Blood Bank BDRS
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum EpisodeType {
  RAWAT_JALAN
  RAWAT_INAP
  GAWAT_DARURAT
  HOME_CARE
  TELEMEDIS
}

enum EpisodeStatus {
  PLANNED
  WAITLIST
  ACTIVE
  ONHOLD
  FINISHED
  CANCELLED
}

enum EncounterClass {
  AMB
  EMER
  IMP
  VR
  SS
  HH
}

enum EncounterStatus {
  PLANNED
  ARRIVED
  TRIAGED
  WAITING
  ADMITTED
  IN_PROGRESS
  TRANSFERRED
  DISCHARGED
  COMPLETED
  CLOSED
  CANCELLED
  NO_SHOW
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
  BLOCKED
  ISOLATION
}

enum OrderCategory {
  PHARMACY
  LABORATORY
  RADIOLOGY
  PROCEDURE
  DIET
  BLOOD_BANK
}

enum PriorityLevel {
  ROUTINE
  URGENT
  CITO
}

enum OrderStatus {
  DRAFT
  ORDERED
  VERIFIED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum EnterpriseRole {
  ROLE_SUPER_ADMIN
  ROLE_DOCTOR_DPJP
  ROLE_DOCTOR_EMERGENCY
  ROLE_NURSE
  ROLE_PHARMACIST
  ROLE_LAB_ANALYST
  ROLE_RADIOGRAPHER
  ROLE_CASHIER
  ROLE_REGISTRATION_CLERK
  ROLE_MEDICAL_RECORD_OFFICER
  ROLE_IT_ADMIN
}

// ─── 0. CANONICAL TENANT DOMAIN ───
model TenantOrganization {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantCode         String   @unique @map("tenant_code") @db.VarChar(50)
  organizationName   String   @map("organization_name") @db.VarChar(255)
  hospitalType       String   @default("GENERAL_HOSPITAL") @map("hospital_type") @db.VarChar(50)
  kemenkesFaskesCode String?  @map("kemenkes_faskes_code") @db.VarChar(50)
  status             String   @default("ACTIVE") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  subscriptions             TenantSubscription[]
  patients                  Patient[]
  users                     EnterpriseUser[]
  buildings                 Building[]
  floors                    Floor[]
  wards                     Ward[]
  rooms                     Room[]
  beds                      Bed[]
  bedOccupancies            BedOccupancy[]
  bedTransfers              BedTransfer[]
  appointments              Appointment[]
  appointmentAuditLogs      AppointmentAuditLog[]
  queueSequences            QueueSequence[]
  warehouses                PharmacyWarehouse[]
  medications               MedicationCatalog[]
  inventoryBatches          InventoryBatch[]
  stockMovements            InventoryStockMovement[]
  dispenseRecords           PrescriptionDispenseRecord[]
  bloodUnits                BloodDonorUnit[]
  bloodStorageLogs          BloodStorageTemperatureLog[]
  crossmatchTests           BloodCrossmatchTest[]
  bloodIssues               BloodIssueRecord[]
  transfusionRecords        BloodTransfusionRecord[]
  bedsideVerifications      BloodBedsideVerification[]
  transfusionReactions      TransfusionReactionLog[]
  operatingTheatres         OperatingTheatre[]
  operatingRooms            OperatingRoom[]
  surgerySchedules          SurgerySchedule[]
  surgeryCases              SurgeryCase[]
  surgicalChecklists        SurgicalSafetyChecklist[]
  anesthesiaRecords         AnesthesiaRecord[]
  postOpHandoffs            PostOpHandoff[]
  icuAssessments            IcuAcuityAssessment[]
  clinicalStaffProfiles     ClinicalStaffProfile[]
  staffCredentials          StaffCredential[]
  clinicalPrivileges        ClinicalPrivilege[]
  staffRosters              StaffRoster[]
  shiftAssignments          ShiftAssignment[]
  onCallSchedules           OnCallSchedule[]
  clinicalAuthorizationLogs ClinicalAuthorizationLog[]
  episodes                  EpisodeOfCare[]
  encounters                Encounter[]
  registrations             PatientRegistration[]
  queueTickets              QueueTicket[]
  bpjsSepRecords            BpjsSepRecord[]
  triageRecords             TriageAssessment[]
  triageSlaTimers           TriageSlaTimer[]
  resuscitationEvents       ResuscitationEvent[]
  soapNotes                 SoapNote[]
  cpptNotes                 CpptNote[]
  allergies                 PatientAllergy[]
  observations              ClinicalObservation[]
  cdssAlerts                CdssAlert[]
  orders                    ClinicalOrder[]
  medicationOrders          MedicationOrder[]
  laboratoryOrders          LaboratoryOrder[]
  radiologyOrders           RadiologyOrder[]
  billingLedgers            BillingLedger[]
  invoices                  HospitalInvoice[]
  inaCbgClaims              InaCbgClaim[]
  auditLogs                 UniversalAuditLog[]

  @@index([status])
  @@map("tenant_organizations")
}

model TenantSubscription {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  planCode        String    @default("PROFESSIONAL_HOSPITAL") @map("plan_code") @db.VarChar(50)
  status          String    @default("ACTIVE_TRIAL") @db.VarChar(30)
  maxBeds         Int       @default(150) @map("max_beds")
  maxUsers        Int       @default(100) @map("max_users")
  featuresEnabled Json      @default("[]") @map("features_enabled")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant TenantOrganization @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("tenant_subscriptions")
}

// ─── 1. MASTER PATIENT DOMAIN ───
model Patient {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  mrn            String   @db.VarChar(30)
  nik            String   @unique @db.VarChar(16)
  ihsNumber      String?  @unique @map("ihs_number") @db.VarChar(30)
  fullName       String   @map("full_name") @db.VarChar(255)
  birthPlace     String?  @map("birth_place") @db.VarChar(100)
  birthDate      DateTime @map("birth_date") @db.Date
  gender         Gender
  bloodType      String?  @map("blood_type") @db.VarChar(5)
  maritalStatus  String?  @map("marital_status") @db.VarChar(20)
  phoneNumber    String   @map("phone_number") @db.VarChar(30)
  email          String?  @db.VarChar(100)
  addressLine    String   @map("address_line") @db.Text
  guarantorType  String   @default("UMUM") @map("guarantor_type") @db.VarChar(50)
  bpjsCardNumber String?  @map("bpjs_card_number") @db.VarChar(30)
  isActive       Boolean  @default(true) @map("is_active")
  isMerged       Boolean  @default(false) @map("is_merged")
  mergedIntoId   String?  @map("merged_into_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         TenantOrganization @relation(fields: [tenantId], references: [id])
  mergedInto     Patient?           @relation("PatientMergeHistory", fields: [mergedIntoId], references: [id])
  mergedPatients Patient[]          @relation("PatientMergeHistory")

  appointments         Appointment[]
  episodes             EpisodeOfCare[]
  encounters           Encounter[]
  registrations        PatientRegistration[]
  queueTickets         QueueTicket[]
  bpjsSepRecords       BpjsSepRecord[]
  triageRecords        TriageAssessment[]
  cdssAlerts           CdssAlert[]
  allergies            PatientAllergy[]
  orders               ClinicalOrder[]
  billingLedgers       BillingLedger[]
  invoices             HospitalInvoice[]
  bedOccupancies       BedOccupancy[]
  dispenseRecords      PrescriptionDispenseRecord[]
  stockMovements       InventoryStockMovement[]
  reservedBloodUnits   BloodDonorUnit[]             @relation("BloodUnitReservedPatient")
  crossmatchTests      BloodCrossmatchTest[]
  bloodIssues          BloodIssueRecord[]
  transfusionRecords   BloodTransfusionRecord[]
  transfusionReactions TransfusionReactionLog[]
  surgerySchedules     SurgerySchedule[]
  surgeryCases         SurgeryCase[]
  anesthesiaRecords    AnesthesiaRecord[]
  postOpHandoffs       PostOpHandoff[]
  icuAssessments       IcuAcuityAssessment[]
  auditLogs            UniversalAuditLog[]

  @@unique([tenantId, mrn], name: "uq_patients_tenant_mrn")
  @@index([tenantId, createdAt])
  @@map("master_patients")
}

// ─── 2. BED MANAGEMENT & WARD HIERARCHY ───
model Building {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  buildingCode String   @map("building_code") @db.VarChar(30)
  buildingName String   @map("building_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant TenantOrganization @relation(fields: [tenantId], references: [id])
  floors Floor[]

  @@unique([tenantId, buildingCode], name: "uq_building_tenant_code")
  @@index([tenantId])
  @@map("master_buildings")
}

model Floor {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  buildingId  String   @map("building_id") @db.Uuid
  floorNumber Int      @map("floor_number")
  floorName   String   @map("floor_name") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   TenantOrganization @relation(fields: [tenantId], references: [id])
  building Building           @relation(fields: [buildingId], references: [id])
  wards    Ward[]
  theatres OperatingTheatre[]

  @@unique([buildingId, floorNumber], name: "uq_floor_building_number")
  @@index([tenantId])
  @@index([buildingId])
  @@map("master_floors")
}

model Ward {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  floorId   String   @map("floor_id") @db.Uuid
  wardCode  String   @map("ward_code") @db.VarChar(30)
  wardName  String   @map("ward_name") @db.VarChar(100)
  wardClass String   @map("ward_class") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant TenantOrganization @relation(fields: [tenantId], references: [id])
  floor  Floor              @relation(fields: [floorId], references: [id])
  rooms  Room[]

  @@unique([tenantId, wardCode], name: "uq_ward_tenant_code")
  @@index([tenantId])
  @@index([floorId])
  @@map("master_wards")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  wardId     String   @map("ward_id") @db.Uuid
  roomNumber String   @map("room_number") @db.VarChar(30)
  genderType String   @default("ALL") @map("gender_type") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant TenantOrganization @relation(fields: [tenantId], references: [id])
  ward   Ward               @relation(fields: [wardId], references: [id])
  beds   Bed[]

  @@unique([wardId, roomNumber], name: "uq_room_ward_number")
  @@index([tenantId])
  @@index([wardId])
  @@map("master_rooms")
}

model Bed {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  bedNumber   String    @map("bed_number") @db.VarChar(30)
  bedStatus   BedStatus @default(AVAILABLE) @map("bed_status")
  dailyTariff Decimal   @default(0.00) @map("daily_tariff") @db.Decimal(15, 2)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        TenantOrganization @relation(fields: [tenantId], references: [id])
  room          Room               @relation(fields: [roomId], references: [id])
  occupancies   BedOccupancy[]
  transfersFrom BedTransfer[]      @relation("BedTransferFrom")
  transfersTo   BedTransfer[]      @relation("BedTransferTo")

  @@unique([roomId, bedNumber], name: "uq_bed_room_number")
  @@index([tenantId])
  @@index([roomId])
  @@index([tenantId, bedStatus])
  @@map("master_beds")
}

model BedOccupancy {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  bedId               String    @map("bed_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  encounterId         String    @map("encounter_id") @db.Uuid
  checkInTime         DateTime  @default(now()) @map("check_in_time") @db.Timestamptz()
  checkOutTime        DateTime? @map("check_out_time") @db.Timestamptz()
  occupancyStatus     String    @default("ACTIVE") @map("occupancy_status") @db.VarChar(30)
  dischargeType       String?   @map("discharge_type") @db.VarChar(50)
  admittingDoctorName String?   @map("admitting_doctor_name") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant    TenantOrganization @relation(fields: [tenantId], references: [id])
  bed       Bed                @relation(fields: [bedId], references: [id])
  patient   Patient            @relation(fields: [patientId], references: [id])
  encounter Encounter          @relation(fields: [encounterId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([encounterId])
  @@index([bedId])
  @@map("bed_occupancies")
}

model BedTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  encounterId    String   @map("encounter_id") @db.Uuid
  fromBedId      String   @map("from_bed_id") @db.Uuid
  toBedId        String   @map("to_bed_id") @db.Uuid
  transferReason String   @map("transfer_reason") @db.Text
  transferredBy  String   @map("transferred_by") @db.VarChar(100)
  transferredAt  DateTime @default(now()) @map("transferred_at") @db.Timestamptz()

  tenant    TenantOrganization @relation(fields: [tenantId], references: [id])
  encounter Encounter          @relation(fields: [encounterId], references: [id])
  fromBed   Bed                @relation("BedTransferFrom", fields: [fromBedId], references: [id])
  toBed     Bed                @relation("BedTransferTo", fields: [toBedId], references: [id])

  @@index([tenantId])
  @@index([encounterId])
  @@index([fromBedId])
  @@index([toBedId])
  @@map("bed_transfers")
}

// ─── 3. APPOINTMENTS & OUTPATIENT QUEUES DOMAIN ───
model Appointment {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  appointmentNumber  String    @unique @map("appointment_number") @db.VarChar(30)
  patientId          String    @map("patient_id") @db.Uuid
  doctorId           String    @map("doctor_id") @db.VarChar(50)
  doctorName         String    @map("doctor_name") @db.VarChar(100)
  departmentId       String    @map("department_id") @db.VarChar(50)
  departmentName     String    @map("department_name") @db.VarChar(100)
  appointmentDate    DateTime  @map("appointment_date") @db.Date
  slotTime           String    @map("slot_time") @db.VarChar(20)
  bookingSource      String    @default("ON_SITE") @map("booking_source") @db.VarChar(30)
  guarantorType      String    @default("UMUM") @map("guarantor_type") @db.VarChar(50)
  status             String    @default("BOOKED") @db.VarChar(30)
  cancellationReason String?   @map("cancellation_reason") @db.Text
  rescheduledFromId  String?   @map("rescheduled_from_id") @db.Uuid
  bpjsBookingCode    String?   @map("bpjs_booking_code") @db.VarChar(50)
  ticketNumber       String?   @map("ticket_number") @db.VarChar(20)
  version            Int       @default(1)
  bookedAt           DateTime  @default(now()) @map("booked_at") @db.Timestamptz()
  checkedInAt        DateTime? @map("checked_in_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          TenantOrganization    @relation(fields: [tenantId], references: [id])
  patient         Patient               @relation(fields: [patientId], references: [id])
  rescheduledFrom Appointment?          @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment[]         @relation("AppointmentReschedule")
  auditLogs       AppointmentAuditLog[]
  registrations   PatientRegistration[]
  queueTickets    QueueTicket[]

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId, appointmentDate])
  @@index([tenantId, status])
  @@map("appointments")
}

model AppointmentAuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  actionType    String    @map("action_type") @db.VarChar(50)
  oldSlotDate   DateTime? @map("old_slot_date") @db.Date
  oldSlotTime   String?   @map("old_slot_time") @db.VarChar(20)
  newSlotDate   DateTime? @map("new_slot_date") @db.Date
  newSlotTime   String?   @map("new_slot_time") @db.VarChar(20)
  reason        String?   @db.Text
  actorId       String    @map("actor_id") @db.VarChar(50)
  actorName     String    @map("actor_name") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant      TenantOrganization @relation(fields: [tenantId], references: [id])
  appointment Appointment        @relation(fields: [appointmentId], references: [id])

  @@index([tenantId])
  @@index([appointmentId])
  @@map("appointment_audit_logs")
}

model QueueSequence {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  poolCode            String   @map("pool_code") @db.VarChar(30)
  queueDate           DateTime @map("queue_date") @db.Date
  lastNumber          Int      @default(0) @map("last_number")
  currentCalledNumber Int      @default(0) @map("current_called_number")
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant TenantOrganization @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, poolCode, queueDate], name: "uq_queue_sequence")
  @@index([tenantId])
  @@map("queue_sequences")
}

// ─── 4. PHARMACY MULTI-WAREHOUSE & FEFO INVENTORY ───
model PharmacyWarehouse {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  warehouseCode       String   @map("warehouse_code") @db.VarChar(30)
  warehouseName       String   @map("warehouse_name") @db.VarChar(100)
  warehouseType       String   @default("DEPO") @map("warehouse_type") @db.VarChar(30)
  locationDescription String?  @map("location_description") @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          TenantOrganization           @relation(fields: [tenantId], references: [id])
  batches         InventoryBatch[]
  stockMovements  InventoryStockMovement[]
  dispenseRecords PrescriptionDispenseRecord[]

  @@unique([tenantId, warehouseCode], name: "uq_warehouse_tenant_code")
  @@index([tenantId])
  @@map("pharmacy_warehouses")
}

model MedicationCatalog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  itemCode         String   @map("item_code") @db.VarChar(50)
  itemName         String   @map("item_name") @db.VarChar(255)
  genericName      String?  @map("generic_name") @db.VarChar(255)
  dosageForm       String   @map("dosage_form") @db.VarChar(50)
  strength         String?  @db.VarChar(50)
  packageUnit      String   @map("package_unit") @db.VarChar(30)
  dispenseUnit     String   @map("dispense_unit") @db.VarChar(30)
  conversionFactor Int      @default(1) @map("conversion_factor")
  kfaCode          String?  @map("kfa_code") @db.VarChar(50)
  isHighAlert      Boolean  @default(false) @map("is_high_alert")
  isLasa           Boolean  @default(false) @map("is_lasa")
  isNarcotic       Boolean  @default(false) @map("is_narcotic")
  isPsychotropic   Boolean  @default(false) @map("is_psychotropic")
  isAntibiotic     Boolean  @default(false) @map("is_antibiotic")
  minStockAlert    Int      @default(10) @map("min_stock_alert")
  maxStockLevel    Int      @default(1000) @map("max_stock_level")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         TenantOrganization       @relation(fields: [tenantId], references: [id])
  batches        InventoryBatch[]
  stockMovements InventoryStockMovement[]

  @@unique([tenantId, itemCode], name: "uq_medication_tenant_code")
  @@index([tenantId])
  @@map("medication_catalog")
}

model InventoryBatch {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  medicationId      String   @map("medication_id") @db.Uuid
  batchNumber       String   @map("batch_number") @db.VarChar(100)
  expiryDate        DateTime @map("expiry_date") @db.Date
  initialQuantity   Int      @map("initial_quantity")
  availableQuantity Int      @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  unitCost          Decimal  @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  unitPrice         Decimal  @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          TenantOrganization           @relation(fields: [tenantId], references: [id])
  warehouse       PharmacyWarehouse            @relation(fields: [warehouseId], references: [id])
  medication      MedicationCatalog            @relation(fields: [medicationId], references: [id])
  stockMovements  InventoryStockMovement[]
  dispenseRecords PrescriptionDispenseRecord[]

  @@unique([warehouseId, medicationId, batchNumber], name: "uq_batch_warehouse_med")
  @@index([tenantId])
  @@index([warehouseId, medicationId, expiryDate])
  @@map("inventory_batches")
}

model InventoryStockMovement {
  id               String   @id @default(uuid()) @db.Uuid
