// ─── 5. BLOOD BANK (BDRS) UNITS & TRANSFUSION ───
model BloodDonorUnit {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String   @map("tenant_id") @db.Uuid
  unitNumber                String   @map("unit_number") @db.VarChar(50)
  productType               String   @map("product_type") @db.VarChar(30)
  aboType                   String   @map("abo_type") @db.VarChar(5)
  rhesusType                String   @map("rhesus_type") @db.VarChar(10)
  volumeMl                  Int      @map("volume_ml")
  donationDate              DateTime @map("donation_date") @db.Date
  expiryDate                DateTime @map("expiry_date") @db.Timestamptz()
  storageTemperatureCelsius Decimal? @map("storage_temperature_celsius") @db.Decimal(4, 1)
  storageLocation           String   @map("storage_location") @db.VarChar(100)
  screeningStatus           String   @default("NON_REACTIVE") @map("screening_status") @db.VarChar(30)
  status                    String   @default("AVAILABLE") @db.VarChar(30)
  reservedForPatientId      String?  @map("reserved_for_patient_id") @db.Uuid
  reservedForEncounterId    String?  @map("reserved_for_encounter_id") @db.Uuid
  version                   Int      @default(1)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant               TenantOrganization           @relation(fields: [tenantId], references: [id])
  reservedForPatient   Patient?                     @relation("BloodUnitReservedPatient", fields: [reservedForPatientId], references: [id])
  reservedForEncounter Encounter?                   @relation("BloodUnitReservedEncounter", fields: [reservedForEncounterId], references: [id])
  crossmatchTests      BloodCrossmatchTest[]
  issues               BloodIssueRecord[]
  transfusionRecords   BloodTransfusionRecord[]
  temperatureLogs      BloodStorageTemperatureLog[]

  @@unique([tenantId, unitNumber], name: "uq_blood_unit_tenant_number")
  @@index([tenantId])
  @@index([tenantId, status, expiryDate])
  @@map("blood_donor_units")
}

model BloodStorageTemperatureLog {
