rules_version = '2';
// NurseFlow EHIS 2026 - FHIR-Native Enterprise Security Rules
// JCI-Grade: Strict Role Enforcement, Zero-Trust, Server-Side Immutable Audit

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS (ZERO-TRUST) ───────────────────────
    function isAuth() { return request.auth != null; }
    function getRole() { return request.auth.token.role; }
    
    function isDoctor()     { return getRole() == 'DOCTOR'; }
    function isNurse()      { return getRole() == 'NURSE'; }
    function isAdmin()      { return getRole() == 'ADMIN'; }
    function isPharmacist() { return getRole() == 'PHARMACIST'; }
    function isClinical()   { return isDoctor() || isNurse(); }
    
    // Verifikasi kepemilikan data/token
    function verifyIdentity(field) {
      return request.resource.data[field] == request.auth.uid;
    }

    // ─── AUDIT EVENTS (EVENT SOURCING) ────────────────────────
    match /audit_events/{eventId} {
      // DILARANG KERAS MENGAKSES/MENULIS DARI CLIENT! 
      // Harus ditulis oleh Firebase Admin SDK (Cloud Functions)
      allow read, write: if false;
    }

    // ─── MASTER DATA & USERS ──────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth() && (request.auth.uid == userId || isAdmin() || isClinical());
      allow create, update: if isAuth() && isAdmin();
      allow delete: if false;
    }
    
    match /fhir_practitioners/{practitionerId} {
      allow read:   if isAuth();
      allow create, update: if isAuth() && isAdmin();
      allow delete: if false;
    }

    // ─── PATIENT REGISTRATION ─────────────────────────────────
    match /fhir_patients/{patientId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isAdmin() || isClinical());
      allow update: if isAuth() && (isAdmin() || isClinical());
      allow delete: if false; // JCI: Data medis tidak boleh dihapus
    }

    // ─── CLINICAL ENCOUNTERS ──────────────────────────────────
    match /fhir_encounters/{encounterId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isAdmin() || isClinical());
      allow update: if isAuth() && (isAdmin() || isClinical());
      allow delete: if false;
    }

    // ─── OBSERVATIONS (Vitals, Lab Results, EWS) ──────────────
    match /fhir_observations/{obsId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isClinical();
      allow update: if isAuth() && isClinical(); // Sebaiknya append-only, tapi diijinkan untuk koreksi draft
      allow delete: if false;
    }

    // ─── CONDITIONS (Diagnosis ICD-10) ────────────────────────
    match /fhir_conditions/{conditionId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isDoctor(); // Hanya dokter yang mendiagnosis
      allow update: if isAuth() && isDoctor();
      allow delete: if false;
    }

    // ─── MEDICATION REQUESTS (CPOE / e-Prescribing) ───────────
    match /fhir_medicationRequests/{medReqId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isDoctor(); // Hanya dokter meresepkan
      allow update: if isAuth() && (isDoctor() || isPharmacist()); // Farmasi untuk update status dispense
      allow delete: if false;
    }

  }
}
