# ==============================================================================
# NurseFlow Enterprise HIS 2026 — Environment Configuration Template
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production
PORT=80

# --- PostgreSQL Database ---
POSTGRES_DB=nurseflow_enterprise_his
POSTGRES_USER=his_admin
POSTGRES_PASSWORD=ChangeThisToStrongPasswordInProd2026!
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432

# --- Redis Cache & Pub/Sub ---
REDIS_PASSWORD=ChangeThisToStrongRedisPasswordInProd2026!
REDIS_HOST=redis-cache
REDIS_PORT=6379

# --- Security & JWT Secrets ---
JWT_SECRET=super_secret_hmac_sha256_key_nurseflow_2026
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Integration Credentials (BPJS & Kemkes SATUSEHAT) ---
BPJS_CONS_ID=your_bpjs_cons_id
BPJS_SECRET_KEY=your_bpjs_secret_key
BPJS_USER_KEY=your_bpjs_user_key
SATUSEHAT_ORG_ID=your_satusehat_org_id
SATUSEHAT_CLIENT_ID=your_satusehat_client_id
SATUSEHAT_CLIENT_SECRET=your_satusehat_client_secret
