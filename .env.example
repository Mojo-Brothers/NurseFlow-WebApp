# ==============================================================================
# NurseFlow Enterprise HIS 2026 — Environment Configuration Template
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
# DO NOT COMMIT ACTUAL PASSWORDS, KEYS, OR TOKENS TO SOURCE CONTROL.
# ==============================================================================

# ─── 1. Application Runtime ───
NODE_ENV=development
PORT=5000
NODE_ID=node-local-01
DEFAULT_TENANT_ID=TENANT-HOSPITAL-01

# ─── 2. Database Infrastructure (PostgreSQL 16) ───
POSTGRES_DB=nurseflow_enterprise_his
POSTGRES_USER=his_admin
POSTGRES_PASSWORD=your_local_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://his_admin:your_local_postgres_password_here@localhost:5432/nurseflow_enterprise_his?schema=public

# ─── 3. High-Speed Distributed Cache (Redis 7) ───
REDIS_PASSWORD=your_local_redis_password_here
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── 4. Cryptographic Authentication & JWT Security ───
# Generate a cryptographically secure 256-bit secret key (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_hmac_sha256_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── 5. Kemkes RI SATUSEHAT Platform (Sandbox Credentials) ───
SATUSEHAT_ENV=sandbox
SATUSEHAT_BASE_URL=https://api-satusehat-stg.kemkes.go.id
SATUSEHAT_ORG_ID=your_satusehat_organization_id_here
SATUSEHAT_CLIENT_ID=your_satusehat_client_id_here
SATUSEHAT_CLIENT_SECRET=your_satusehat_client_secret_here

# ─── 6. BPJS Kesehatan VClaim 2.0 (Trust Mark Credentials) ───
BPJS_BASE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/vclaim-rest-dev
BPJS_CONS_ID=your_bpjs_consumer_id_here
BPJS_SECRET_KEY=your_bpjs_secret_key_here
BPJS_USER_KEY=your_bpjs_user_key_here

# ─── 7. Frontend Client Build Variables (Vite) ───
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0-dev
VITE_GIT_SHA=local-dev
VITE_FIREBASE_PROJECT_ID=
